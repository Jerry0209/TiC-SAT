    Fault MicroNeonLoad64::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        Addr EA;
        Fault fault = NoFault;

        uint32_t Cpsr = 0;
uint32_t Cpacr64 = 0;
uint64_t XURa = 0;
;
        
            const int MaxNumBytes = 16;
            union MemUnion {
                uint8_t bytes[MaxNumBytes];
                uint32_t floatRegBits[MaxNumBytes / 4];
            };
        ;
        Cpsr = xc->readMiscRegOperand(this, 0);
Cpacr64 = xc->readMiscRegOperand(this, 1);
XURa = 
        ((xc->readIntRegOperand(this, 2)) & mask(aarch64 ? 64 : 32))
    ;
		TheISA::VecRegContainer& tmp_d0 = xc->getWritableVecRegOperand(this, 0);
		auto AA64FpDest = tmp_d0.as<uint32_t>();
		uint32_t& AA64FpDestP0 = AA64FpDest[0];
		uint32_t& AA64FpDestP1 = AA64FpDest[1];
		uint32_t& AA64FpDestP2 = AA64FpDest[2];
		uint32_t& AA64FpDestP3 = AA64FpDest[3];
;
        
    {
        Fault fault = checkFPAdvSIMDEnabled64(xc->tcBase(), Cpsr, Cpacr64);
        if (fault != NoFault)
             return fault;
    }
    
            if (baseIsSP && bits(XURa, 3, 0) &&
                SPAlignmentCheckEnabled(xc->tcBase())) {
                return std::make_shared<SPAlignmentFault>();
            }
        
            EA = XURa + imm;
        ;

        MemUnion memUnion;
        uint8_t *dataPtr = memUnion.bytes;

        if (fault == NoFault) {
            fault = xc->readMem(EA, dataPtr, accSize, memAccessFlags);
            
            VReg x = {0, 0};
            x.lo = (((XReg) memUnion.floatRegBits[1]) << 32) |
                (XReg) memUnion.floatRegBits[0];
            x.hi = (((XReg) memUnion.floatRegBits[3]) << 32) |
                (XReg) memUnion.floatRegBits[2];
            const unsigned eCount = 16 / (1 << eSize);
            if (isBigEndian64(xc->tcBase())) {
                for (unsigned i = 0; i < eCount; i++) {
                    switch (eSize) {
                      case 0x3:  // 64-bit
                        writeVecElem(&x, (XReg) gtobe(
                            (uint64_t) readVecElem(x, i, eSize)), i, eSize);
                        break;
                      case 0x2:  // 32-bit
                        writeVecElem(&x, (XReg) gtobe(
                            (uint32_t) readVecElem(x, i, eSize)), i, eSize);
                        break;
                      case 0x1:  // 16-bit
                        writeVecElem(&x, (XReg) gtobe(
                            (uint16_t) readVecElem(x, i, eSize)), i, eSize);
                        break;
                      default:  // 8-bit
                        break;  // Nothing to do here
                    }
                }
            } else {
                for (unsigned i = 0; i < eCount; i++) {
                    switch (eSize) {
                      case 0x3:  // 64-bit
                        writeVecElem(&x, (XReg) gtole(
                            (uint64_t) readVecElem(x, i, eSize)), i, eSize);
                        break;
                      case 0x2:  // 32-bit
                        writeVecElem(&x, (XReg) gtole(
                            (uint32_t) readVecElem(x, i, eSize)), i, eSize);
                        break;
                      case 0x1:  // 16-bit
                        writeVecElem(&x, (XReg) gtole(
                            (uint16_t) readVecElem(x, i, eSize)), i, eSize);
                        break;
                      default:  // 8-bit
                        break;  // Nothing to do here
                    }
                }
            }
            memUnion.floatRegBits[0] = (uint32_t) x.lo;
            memUnion.floatRegBits[1] = (uint32_t) (x.lo >> 32);
            memUnion.floatRegBits[2] = (uint32_t) x.hi;
            memUnion.floatRegBits[3] = (uint32_t) (x.hi >> 32);
        
            AA64FpDestP0 = gtoh(memUnion.floatRegBits[0]);
            
            AA64FpDestP1 = gtoh(memUnion.floatRegBits[1]);
            
            AA64FpDestP2 = gtoh(memUnion.floatRegBits[2]);
            
            AA64FpDestP3 = gtoh(memUnion.floatRegBits[3]);
            ;
        }

        if (fault == NoFault) {
            
        if (traceData) {
            warn_once("Vectors not supported yet in tracedata");
            /*traceData->setData(final_val);*/
        }
        ;
        }

        return fault;
    }

